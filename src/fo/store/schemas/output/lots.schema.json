{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "as_of",
    "stale_accounts",
    "stale_providers",
    "symbol",
    "lots"
  ],
  "properties": {
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "stale_accounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symbol": {
      "type": "string"
    },
    "lots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lot_id",
          "basis",
          "gain",
          "holding_period",
          "reason"
        ],
        "properties": {
          "basis": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+(\\.\\d+)?([Ee][+-]?\\d+)?$"
          },
          "gain": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?\\d+(\\.\\d+)?([Ee][+-]?\\d+)?$"
          },
          "holding_period": {
            "enum": [
              "long",
              "short",
              null
            ]
          }
        }
      }
    }
  }
}
