{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "path",
    "frontmatter",
    "body"
  ],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^reports/(?!.*\\.parts/).+\\.md$"
    },
    "frontmatter": {
      "type": "object",
      "required": [
        "kind",
        "subject",
        "date"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      }
    },
    "body": {
      "type": "string"
    }
  }
}
