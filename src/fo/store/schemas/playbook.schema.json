{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "title", "attribution", "scope", "criteria", "verdict"],
  "properties": {
    "name": {"type": "string"}, "title": {"type": "string"},
    "attribution": {"type": "string", "minLength": 1},
    "scope": {"enum": ["company", "portfolio", "market"]},
    "criteria": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "title", "kind", "evidence"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "kind": {"enum": ["mechanical", "judgment"]}, "evidence": {"type": "array"}, "threshold": {"type": "number"}, "borderline": {"type": "number", "minimum": 0}},
      "allOf": [{"if": {"properties": {"kind": {"const": "mechanical"}}}, "then": {"required": ["metric", "op", "threshold"]}}]
    }},
    "verdict": {"type": "object", "required": ["format"], "properties": {"format": {"type": "string"}}}
  }
}
