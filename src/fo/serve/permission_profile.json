{
  "note": "Claude Code permission rules for headless advisor runs. Defence in depth: fo refuses restricted commands under FO_SERVE_RUN, and the fo.serve.guard hook confines every tool call. tests/test_serve_runs.py checks this against the office settings fo init writes and the commands fo refuses.",
  "allow": [
    "Bash(fo *)",
    "Read(./**)",
    "Edit(./reports/**)",
    "Write(./reports/**)"
  ],
  "deny": [
    "Read(secrets/**)",
    "Read(cache/**)",
    "Read(imports/**)",
    "Read(medical/**)",
    "Read(.git/**)",
    "Read(store.sqlite*)",
    "Read(.fo.lock)",
    "Edit(secrets/**)",
    "Edit(data/**)",
    "Edit(notebook/**)",
    "Edit(profile/**)",
    "Edit(office.toml)",
    "Edit(.claude/**)",
    "Edit(.agents/**)",
    "WebFetch",
    "WebSearch",
    "NotebookEdit",
    "Bash(python *)",
    "Bash(python3 *)",
    "Bash(uv run python *)",
    "Bash(uv run fo *)",
    "Bash(curl *)",
    "Bash(wget *)",
    "Bash(ssh *)",
    "Bash(open *)",
    "Bash(osascript *)",
    "Bash(pip *)",
    "Bash(git push *)",
    "Bash(fo setup)",
    "Bash(fo setup *)",
    "Bash(fo auth)",
    "Bash(fo auth *)",
    "Bash(fo sync)",
    "Bash(fo sync -*)",
    "Bash(fo commit)",
    "Bash(fo commit *)",
    "Bash(fo schedule)",
    "Bash(fo schedule *)",
    "Bash(fo notify)",
    "Bash(fo notify *)",
    "Bash(fo init)",
    "Bash(fo init *)",
    "Bash(fo migrate-v1)",
    "Bash(fo migrate-v1 *)",
    "Bash(fo reindex)",
    "Bash(fo reindex *)",
    "Bash(fo skills sync)",
    "Bash(fo skills sync *)",
    "Bash(fo serve)",
    "Bash(fo serve *)"
  ]
}
